SWITCH_BASE_URL=http://127.0.0.1:PORT
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_SOURCE_ROOM_ID=
SWITCH_SOURCE_ROOM_IDS=
SWITCH_SOURCE_PLATFORM=discord
# Optional JSON mapping for mixed source rooms: {"discord-room-id":"discord","mattermost-room-id":"mattermost","telegram-room-id":"telegram"}
SWITCH_SOURCE_PLATFORMS=
# Optional JSON mapping: {"discord-room-id":["PRODUCT"],"support-room-id":["COMMITMENT"]}
SWITCH_SOURCE_CATEGORIES=
# Revenue roles per room. Example: {"discord-room":"discord","sales-room":"sales","csm-room":"csm","support-source-room":"csm"}
REVENUE_SOURCES=
# Native Slack channel IDs for Slack source rooms: {"support-source-room-id":"C12345678"}
SLACK_SOURCE_CHANNELS=
SWITCH_FOUNDER_ROOM_ID=
SWITCH_PRODUCT_ROOM_ID=
SWITCH_SALES_ROOM_ID=
SWITCH_SUPPORT_ROOM_ID=
FOUNDER_SWITCH_SENDER_ID=
FOUNDER_SLACK_USER_ID=
SWITCH_AGENT_SENDER_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_FOUNDER_APP_TOKEN=
SLACK_FOUNDER_BOT_TOKEN=
SLACK_WORKSPACE_ID=
# Native channel IDs are distinct from the SWITCH_*_ROOM_ID values above.
SLACK_FOUNDER_CHANNEL_ID=
SLACK_PRODUCT_CHANNEL_ID=
SLACK_SALES_CHANNEL_ID=
SLACK_SUPPORT_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SOURCE_CHANNEL_ID=
# Mattermost intake uses a channel member token for post and author lookups.
MATTERMOST_URL=
MATTERMOST_PUBLIC_URL=
MATTERMOST_TEAM=
MATTERMOST_READ_TOKEN=
# JSON mapping from Switch room ID to native Mattermost channel ID.
MATTERMOST_SOURCE_CHANNELS=
# Optional fallback: a separate read-only bot in each source supergroup. Never reuse the Switch Telegram bot token.
TELEGRAM_EVIDENCE_BOT_TOKEN=
# JSON mapping from Switch room ID to native Telegram supergroup chat ID: {"telegram-room-id":"-1001234567890"}
TELEGRAM_SOURCE_CHATS=
# Preferred Docker setup: read-only access to Switch's message correlation table.
TELEGRAM_DB_HOST=
TELEGRAM_DB_PORT=
TELEGRAM_DB_NAME=
TELEGRAM_DB_USER=
TELEGRAM_DB_PASSWORD=
TELEGRAM_DB_TENANT_ID=
GOOGLE_PRODUCT_DOC_ID=
GOOGLE_PRODUCT_DOC_TITLE=
# The named demo Doc currently allows public text export. This is not OAuth Docs API access.
GOOGLE_DOC_PUBLIC_EXPORT=false
GOOGLE_REVENUE_SHEET_ID=
# Revenue-only service account. In Docker, use /run/founder-loop-secrets/revenue-reader.json.
GOOGLE_REVENUE_CREDENTIALS=
# Public export is for a workbook with fictional demo records only.
GOOGLE_REVENUE_PUBLIC_EXPORT=false
GOOGLE_ACCESS_TOKEN=
# Optional shared credentials for legacy Google integrations.
GOOGLE_APPLICATION_CREDENTIALS=
ENABLE_SHEET_WRITE=false
# Native Slack user IDs (or exact Switch sender IDs when native IDs are unavailable).
COMMITMENT_STAFF_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Claude Code advisory on new urgent Revenue cards. Sends a short source excerpt to Claude.
# Enable only when the agent's own runtime can run an authenticated native Claude Code executable.
FOUNDER_LOOP_CLAUDE_REVIEW=false
CLAUDE_CODE_EXECUTABLE=
MIN_SIGNAL_CONFIDENCE=0.65
FOUNDER_LOOP_DB=./data/founder-loop.sqlite
FOUNDER_LOOP_ENABLED_CATEGORIES=PRODUCT
# To enable founder requests, add GENERAL here and to the desired SWITCH_SOURCE_CATEGORIES entries.

# Source mode is selected by the command: `demo` is SIMULATED, `live` is LIVE.
