SWITCH_BASE_URL=http://127.0.0.1:PORT
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_SOURCE_ROOM_ID=
SWITCH_SOURCE_ROOM_IDS=
SWITCH_SOURCE_PLATFORM=discord
# Optional JSON mapping for mixed Discord/Slack source rooms: {"room-id":"slack"}
SWITCH_SOURCE_PLATFORMS=
SWITCH_FOUNDER_ROOM_ID=
SWITCH_PRODUCT_ROOM_ID=
SWITCH_SALES_ROOM_ID=
SWITCH_SUPPORT_ROOM_ID=
FOUNDER_SWITCH_SENDER_ID=
FOUNDER_SLACK_USER_ID=
SWITCH_AGENT_SENDER_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
GOOGLE_PRODUCT_DOC_ID=
GOOGLE_PRODUCT_DOC_TITLE=
# The named demo Doc currently allows public text export. This is not OAuth Docs API access.
GOOGLE_DOC_PUBLIC_EXPORT=false
GOOGLE_REVENUE_SHEET_ID=
GOOGLE_ACCESS_TOKEN=
# Optional service-account JSON file placed under ignored secrets/ and shared on the one Doc/Sheet.
GOOGLE_APPLICATION_CREDENTIALS=
ENABLE_SHEET_WRITE=false
OPENAI_API_KEY=
OPENAI_MODEL=
MIN_SIGNAL_CONFIDENCE=0.65
FOUNDER_LOOP_DB=./data/founder-loop.sqlite

# Source mode is selected by the command: `demo` is SIMULATED, `live` is LIVE.
